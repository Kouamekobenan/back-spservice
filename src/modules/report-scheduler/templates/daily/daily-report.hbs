<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <title>Rapport Journalier — {{shopName}}</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; color: #333; }
    .container { max-width: 650px; margin: 32px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .header { background: #1a73e8; padding: 24px 32px; }
    .header h1 { color: #fff; margin: 0 0 4px; font-size: 20px; }
    .header p { color: #cce0ff; margin: 0; font-size: 13px; }
    .body { padding: 24px 32px; }
    .kpi-grid { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
    .kpi { flex: 1; min-width: 120px; background: #f8f9fa; border-radius: 8px; padding: 16px; text-align: center; }
    .kpi .value { font-size: 22px; font-weight: bold; color: #1a73e8; }
    .kpi .label { font-size: 11px; color: #888; margin-top: 4px; text-transform: uppercase; }
    .kpi.green .value { color: #34a853; }
    .kpi.red .value { color: #ea4335; }
    h3 { font-size: 14px; font-weight: bold; color: #555; border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; margin: 20px 0 12px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { background: #f8f9fa; padding: 8px 10px; text-align: left; color: #666; font-weight: normal; }
    td { padding: 8px 10px; border-bottom: 1px solid #f0f0f0; }
    .badge-warn { background: #fff3cd; color: #856404; border-radius: 4px; padding: 2px 8px; font-size: 12px; }
    .footer { background: #f8f9fa; padding: 14px 32px; text-align: center; font-size: 11px; color: #aaa; }
  </style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>📊 Rapport Journalier — {{shopName}}</h1>
    <p>{{date}}</p>
  </div>
  <div class="body">
    <div class="kpi-grid">
      <div class="kpi green">
        <div class="value">{{totalRevenue}} F</div>
        <div class="label">Chiffre d'affaires</div>
      </div>
      <div class="kpi">
        <div class="value">{{totalSales}}</div>
        <div class="label">Ventes</div>
      </div>
      <div class="kpi red">
        <div class="value">{{totalExpenses}} F</div>
        <div class="label">Dépenses</div>
      </div>
      <div class="kpi green">
        <div class="value">{{netRevenue}} F</div>
        <div class="label">Bénéfice net</div>
      </div>
    </div>

    {{#if topProducts.length}}
    <h3>🏆 Top 5 Produits du jour</h3>
    <table>
      <thead><tr><th>Produit</th><th>Qté vendue</th><th>Revenu (FCFA)</th></tr></thead>
      <tbody>
        {{#each topProducts}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.qty}}</td>
          <td>{{this.revenue}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if paymentBreakdown.length}}
    <h3>💳 Répartition des paiements</h3>
    <table>
      <thead><tr><th>Mode</th><th>Transactions</th><th>Montant (FCFA)</th></tr></thead>
      <tbody>
        {{#each paymentBreakdown}}
        <tr>
          <td>{{this.method}}</td>
          <td>{{this.count}}</td>
          <td>{{this.amount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if lowStockProducts.length}}
    <h3>⚠️ Alertes Stock Bas</h3>
    <table>
      <thead><tr><th>Produit</th><th>Stock restant</th><th>Unité</th></tr></thead>
      <tbody>
        {{#each lowStockProducts}}
        <tr>
          <td>{{this.name}}</td>
          <td><span class="badge-warn">{{this.stock}}</span></td>
          <td>{{this.unit}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}
  </div>
  <div class="footer">&copy; {{year}} SP Service — Rapport généré automatiquement</div>
</div>
</body>
</html>
