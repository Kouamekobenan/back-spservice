<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <title>Rapport Journalier — {{shopName}}</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; color: #333; }
    .container { max-width: 650px; margin: 32px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .header { background: #1a73e8; padding: 24px 32px; }
    .header h1 { color: #fff; margin: 0 0 4px; font-size: 20px; }
    .header p { color: #cce0ff; margin: 0; font-size: 13px; }
    .body { padding: 24px 32px; }
    .kpi-grid { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .kpi { flex: 1; min-width: 110px; background: #f8f9fa; border-radius: 8px; padding: 14px 10px; text-align: center; border-top: 3px solid #e0e0e0; }
    .kpi.blue   { border-color: #1a73e8; } .kpi.blue   .value { color: #1a73e8; }
    .kpi.red    { border-color: #ea4335; } .kpi.red    .value { color: #ea4335; }
    .kpi.green  { border-color: #34a853; } .kpi.green  .value { color: #34a853; }
    .kpi .value { font-size: 18px; font-weight: bold; }
    .kpi .label { font-size: 10px; color: #888; margin-top: 4px; text-transform: uppercase; letter-spacing: .5px; }
    .margin-box { background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: 8px; padding: 16px 20px; margin-bottom: 20px; }
    .margin-box .title { font-size: 13px; color: #388e3c; font-weight: bold; margin-bottom: 10px; }
    .margin-row { display: flex; justify-content: space-between; font-size: 13px; padding: 4px 0; }
    .margin-row.total { border-top: 1px solid #a5d6a7; margin-top: 8px; padding-top: 10px; font-weight: bold; font-size: 15px; }
    .margin-row .lbl { color: #555; }
    .margin-row .val { color: #333; }
    .margin-row.total .val { color: #2e7d32; }
    .pct { display: inline-block; background: #1a73e8; color: #fff; border-radius: 10px; padding: 1px 8px; font-size: 11px; margin-left: 6px; }
    h3 { font-size: 13px; font-weight: bold; color: #555; border-bottom: 2px solid #f0f0f0; padding-bottom: 6px; margin: 20px 0 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { background: #f8f9fa; padding: 7px 10px; text-align: left; color: #666; font-weight: normal; }
    td { padding: 7px 10px; border-bottom: 1px solid #f5f5f5; }
    .badge-warn { background: #fff3cd; color: #856404; border-radius: 4px; padding: 2px 7px; font-size: 11px; }
    .footer { background: #f8f9fa; padding: 14px 32px; text-align: center; font-size: 11px; color: #aaa; }
  </style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>Rapport Journalier - {{shopName}}</h1>
    <p>{{date}}</p>
  </div>
  <div class="body">

    <div class="kpi-grid">
      <div class="kpi blue">
        <div class="value">{{totalRevenue}} F</div>
        <div class="label">CA Total</div>
      </div>
      <div class="kpi">
        <div class="value">{{totalSales}}</div>
        <div class="label">Ventes</div>
      </div>
      <div class="kpi red">
        <div class="value">{{cogs}} F</div>
        <div class="label">Cout marchand.</div>
      </div>
      <div class="kpi green">
        <div class="value">{{grossMargin}} F</div>
        <div class="label">Marge brute</div>
      </div>
    </div>

    <div class="margin-box">
      <div class="title">Decomposition financiere du jour</div>
      <div class="margin-row">
        <span class="lbl">Chiffre d'affaires (CA)</span>
        <span class="val">{{totalRevenue}} FCFA</span>
      </div>
      <div class="margin-row">
        <span class="lbl">- Cout des marchandises vendues</span>
        <span class="val">{{cogs}} FCFA</span>
      </div>
      <div class="margin-row">
        <span class="lbl">= Marge brute <span class="pct">{{grossMarginPct}}%</span></span>
        <span class="val">{{grossMargin}} FCFA</span>
      </div>
      <div class="margin-row">
        <span class="lbl">- Depenses operationnelles</span>
        <span class="val">{{totalExpenses}} FCFA</span>
      </div>
      <div class="margin-row total">
        <span class="lbl">= Benefice net</span>
        <span class="val">{{netRevenue}} FCFA</span>
      </div>
    </div>

    {{#if topProducts.length}}
    <h3>Top 5 Produits du jour</h3>
    <table>
      <thead><tr><th>Produit</th><th>Qte</th><th>CA (F)</th><th>Cout (F)</th><th>Marge (F)</th></tr></thead>
      <tbody>
        {{#each topProducts}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.qty}}</td>
          <td>{{this.revenue}}</td>
          <td>{{this.cost}}</td>
          <td><strong>{{this.margin}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if paymentBreakdown.length}}
    <h3>Repartition des paiements</h3>
    <table>
      <thead><tr><th>Mode</th><th>Transactions</th><th>Montant (F)</th></tr></thead>
      <tbody>
        {{#each paymentBreakdown}}
        <tr><td>{{this.method}}</td><td>{{this.count}}</td><td>{{this.amount}}</td></tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if lowStockProducts.length}}
    <h3>Alertes Stock Bas</h3>
    <table>
      <thead><tr><th>Produit</th><th>Stock restant</th><th>Unite</th></tr></thead>
      <tbody>
        {{#each lowStockProducts}}
        <tr>
          <td>{{this.name}}</td>
          <td><span class="badge-warn">{{this.stock}}</span></td>
          <td>{{this.unit}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

  </div>
  <div class="footer">&copy; {{year}} SP Service - Rapport genere automatiquement</div>
</div>
</body>
</html>
