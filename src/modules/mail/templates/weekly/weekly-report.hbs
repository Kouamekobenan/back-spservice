<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <title>Rapport Hebdomadaire — {{shopName}}</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; color: #333; }
    .container { max-width: 650px; margin: 32px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .header { background: #0f9d58; padding: 24px 32px; }
    .header h1 { color: #fff; margin: 0 0 4px; font-size: 20px; }
    .header p { color: #c8f0dd; margin: 0; font-size: 13px; }
    .body { padding: 24px 32px; }
    .compare-grid { display: flex; gap: 16px; margin-bottom: 20px; }
    .compare-card { flex: 1; border-radius: 8px; padding: 16px; }
    .compare-card.current  { background: #e6f4ea; border: 2px solid #0f9d58; }
    .compare-card.previous { background: #f8f9fa; border: 2px solid #e0e0e0; }
    .compare-card h4 { margin: 0 0 10px; font-size: 13px; color: #555; }
    .compare-card .val { font-size: 17px; font-weight: bold; margin-bottom: 2px; }
    .compare-card.current .val { color: #0f9d58; }
    .compare-card.previous .val { color: #888; }
    .compare-card .sub { font-size: 12px; color: #888; line-height: 1.6; }
    .badges { margin-bottom: 16px; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold; margin-right: 8px; }
    .badge.up   { background: #e6f4ea; color: #0f9d58; }
    .badge.down { background: #fce8e6; color: #ea4335; }
    .badge.flat { background: #f8f9fa; color: #888; }
    .margin-box { background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: 8px; padding: 14px 18px; margin-bottom: 18px; }
    .margin-box .title { font-size: 12px; color: #388e3c; font-weight: bold; margin-bottom: 8px; }
    .margin-row { display: flex; justify-content: space-between; font-size: 12px; padding: 3px 0; }
    .margin-row.total { border-top: 1px solid #a5d6a7; margin-top: 6px; padding-top: 8px; font-weight: bold; font-size: 14px; }
    .margin-row .lbl { color: #555; }
    .margin-row .val { color: #333; }
    .margin-row.total .val { color: #2e7d32; }
    h3 { font-size: 13px; font-weight: bold; color: #555; border-bottom: 2px solid #f0f0f0; padding-bottom: 6px; margin: 18px 0 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { background: #f8f9fa; padding: 7px 10px; text-align: left; color: #666; font-weight: normal; }
    td { padding: 7px 10px; border-bottom: 1px solid #f5f5f5; }
    .footer { background: #f8f9fa; padding: 14px 32px; text-align: center; font-size: 11px; color: #aaa; }
  </style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>Rapport Hebdomadaire - {{shopName}}</h1>
    <p>{{weekLabel}}</p>
  </div>
  <div class="body">

    <div class="badges">
      CA :
      {{#if (gt revenueGrowth 0)}}<span class="badge up">+{{revenueGrowth}}%</span>{{else}}<span class="badge down">{{revenueGrowth}}%</span>{{/if}}
      &nbsp; Marge :
      {{#if (gt marginGrowth 0)}}<span class="badge up">+{{marginGrowth}}%</span>{{else}}<span class="badge down">{{marginGrowth}}%</span>{{/if}}
      &nbsp; Ventes :
      {{#if (gt salesGrowth 0)}}<span class="badge up">+{{salesGrowth}}%</span>{{else}}<span class="badge down">{{salesGrowth}}%</span>{{/if}}
      vs semaine precedente
    </div>

    <div class="compare-grid">
      <div class="compare-card current">
        <h4>Cette semaine</h4>
        <div class="val">{{currentWeek.revenue}} FCFA</div>
        <div class="sub">
          {{currentWeek.sales}} ventes<br/>
          Cout: {{currentWeek.cogs}} FCFA<br/>
          Marge brute: {{currentWeek.grossMargin}} FCFA<br/>
          Depenses: {{currentWeek.expenses}} FCFA<br/>
          <strong>Benefice net: {{currentWeek.netRevenue}} FCFA</strong>
        </div>
      </div>
      <div class="compare-card previous">
        <h4>Semaine precedente</h4>
        <div class="val">{{previousWeek.revenue}} FCFA</div>
        <div class="sub">
          {{previousWeek.sales}} ventes<br/>
          Cout: {{previousWeek.cogs}} FCFA<br/>
          Marge brute: {{previousWeek.grossMargin}} FCFA<br/>
          Depenses: {{previousWeek.expenses}} FCFA<br/>
          <strong>Benefice net: {{previousWeek.netRevenue}} FCFA</strong>
        </div>
      </div>
    </div>

    <h3>Detail par jour</h3>
    <table>
      <thead><tr><th>Jour</th><th>Ventes</th><th>CA (F)</th><th>Marge (F)</th></tr></thead>
      <tbody>
        {{#each dailyBreakdown}}
        <tr>
          <td>{{this.day}}</td>
          <td>{{this.sales}}</td>
          <td>{{this.revenue}}</td>
          <td><strong>{{this.margin}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    {{#if topProducts.length}}
    <h3>Top 5 Produits</h3>
    <table>
      <thead><tr><th>Produit</th><th>Qte</th><th>CA (F)</th><th>Marge (F)</th></tr></thead>
      <tbody>
        {{#each topProducts}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.qty}}</td>
          <td>{{this.revenue}}</td>
          <td><strong>{{this.margin}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

  </div>
  <div class="footer">&copy; {{year}} SP Service - Rapport genere automatiquement</div>
</div>
</body>
</html>
