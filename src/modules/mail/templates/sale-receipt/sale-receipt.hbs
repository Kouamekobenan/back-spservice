<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reçu de vente</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .header { background: #1a73e8; padding: 24px 32px; }
    .header h1 { color: #ffffff; margin: 0 0 4px 0; font-size: 22px; }
    .header p { color: #cce0ff; margin: 0; font-size: 13px; }
    .body { padding: 32px; color: #333333; }
    .info-grid { display: flex; justify-content: space-between; margin-bottom: 24px; font-size: 14px; }
    .info-grid div { line-height: 1.8; }
    table { width: 100%; border-collapse: collapse; }
    th { background: #1a73e8; color: white; padding: 10px 12px; text-align: left; font-size: 13px; }
    td { padding: 10px 12px; border-bottom: 1px solid #eeeeee; font-size: 14px; }
    tr:last-child td { border-bottom: none; }
    .total-row { background: #f0f7ff; font-weight: bold; }
    .total-row td { padding: 12px; font-size: 16px; }
    .payment { margin-top: 20px; padding: 12px 16px; background: #e8f5e9; border-radius: 6px; font-size: 14px; color: #2e7d32; }
    .footer { background: #f8f9fa; padding: 16px 32px; text-align: center; font-size: 12px; color: #888888; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>{{shopName}}</h1>
      <p>Reçu N° {{receiptNumber}}</p>
    </div>
    <div class="body">
      <div class="info-grid">
        <div>
          <strong>Client :</strong> {{customerName}}<br/>
          <strong>Date :</strong> {{date}}
        </div>
        <div style="text-align:right;">
          <strong>Reçu N° :</strong> {{receiptNumber}}
        </div>
      </div>
      <table>
        <thead>
          <tr>
            <th>Produit</th>
            <th>Qté</th>
            <th>Prix unit. (FCFA)</th>
            <th>Total (FCFA)</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
          <tr>
            <td>{{this.name}}</td>
            <td>{{this.qty}}</td>
            <td>{{this.unitPrice}}</td>
            <td>{{this.total}}</td>
          </tr>
          {{/each}}
          <tr class="total-row">
            <td colspan="3">TOTAL</td>
            <td>{{totalAmount}} FCFA</td>
          </tr>
        </tbody>
      </table>
      <div class="payment">
        Paiement : <strong>{{paymentMethod}}</strong>
      </div>
      <p style="margin-top:24px;font-size:13px;color:#888;">Merci pour votre achat. Ce reçu fait foi de votre transaction.</p>
    </div>
    <div class="footer">
      &copy; {{year}} SP Service — Système ERP/POS pour commerces
    </div>
  </div>
</body>
</html>
