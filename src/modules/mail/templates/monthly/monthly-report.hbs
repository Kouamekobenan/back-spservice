<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <title>Rapport Mensuel — {{shopName}}</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; color: #333; }
    .container { max-width: 650px; margin: 32px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .header { background: #7b1fa2; padding: 24px 32px; }
    .header h1 { color: #fff; margin: 0 0 4px; font-size: 20px; }
    .header p { color: #e1bee7; margin: 0; font-size: 13px; }
    .body { padding: 24px 32px; }
    .kpi-grid { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
    .kpi { flex: 1; min-width: 110px; background: #f8f9fa; border-radius: 8px; padding: 14px 10px; text-align: center; border-top: 3px solid #e0e0e0; }
    .kpi.purple { border-color: #7b1fa2; } .kpi.purple .value { color: #7b1fa2; }
    .kpi.red    { border-color: #ea4335; } .kpi.red    .value { color: #ea4335; }
    .kpi.green  { border-color: #34a853; } .kpi.green  .value { color: #34a853; }
    .kpi .value { font-size: 17px; font-weight: bold; }
    .kpi .label { font-size: 10px; color: #888; margin-top: 4px; text-transform: uppercase; letter-spacing: .5px; }
    .margin-box { background: #f3e5f5; border: 1px solid #ce93d8; border-radius: 8px; padding: 16px 20px; margin-bottom: 18px; }
    .margin-box .title { font-size: 13px; color: #6a1b9a; font-weight: bold; margin-bottom: 10px; }
    .margin-row { display: flex; justify-content: space-between; font-size: 13px; padding: 4px 0; }
    .margin-row.total { border-top: 1px solid #ce93d8; margin-top: 8px; padding-top: 10px; font-weight: bold; font-size: 15px; }
    .margin-row .lbl { color: #555; }
    .margin-row .val { color: #333; }
    .margin-row.total .val { color: #4a148c; }
    .pct { display: inline-block; background: #7b1fa2; color: #fff; border-radius: 10px; padding: 1px 8px; font-size: 11px; margin-left: 6px; }
    .badges { margin-bottom: 16px; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold; margin-right: 8px; }
    .badge.up   { background: #e8f5e9; color: #388e3c; }
    .badge.down { background: #fce8e6; color: #ea4335; }
    .compare-grid { display: flex; gap: 16px; margin-bottom: 18px; }
    .compare-card { flex: 1; border-radius: 8px; padding: 14px; }
    .compare-card.current  { background: #f3e5f5; border: 2px solid #7b1fa2; }
    .compare-card.previous { background: #f8f9fa; border: 2px solid #e0e0e0; }
    .compare-card h4 { margin: 0 0 8px; font-size: 13px; color: #555; }
    .compare-card .val { font-size: 16px; font-weight: bold; }
    .compare-card.current .val { color: #7b1fa2; }
    .compare-card.previous .val { color: #888; }
    .compare-card .sub { font-size: 12px; color: #888; margin-top: 4px; line-height: 1.6; }
    h3 { font-size: 13px; font-weight: bold; color: #555; border-bottom: 2px solid #f0f0f0; padding-bottom: 6px; margin: 18px 0 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { background: #f8f9fa; padding: 7px 10px; text-align: left; color: #666; font-weight: normal; }
    td { padding: 7px 10px; border-bottom: 1px solid #f5f5f5; }
    .badge-warn { background: #fff3cd; color: #856404; border-radius: 4px; padding: 2px 7px; font-size: 11px; }
    .footer { background: #f8f9fa; padding: 14px 32px; text-align: center; font-size: 11px; color: #aaa; }
  </style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>Rapport Mensuel - {{shopName}}</h1>
    <p>{{monthLabel}}</p>
  </div>
  <div class="body">

    <div class="badges">
      CA :
      {{#if (gt revenueGrowth 0)}}<span class="badge up">+{{revenueGrowth}}%</span>{{else}}<span class="badge down">{{revenueGrowth}}%</span>{{/if}}
      &nbsp; Marge :
      {{#if (gt marginGrowth 0)}}<span class="badge up">+{{marginGrowth}}%</span>{{else}}<span class="badge down">{{marginGrowth}}%</span>{{/if}}
      vs mois precedent
    </div>

    <div class="kpi-grid">
      <div class="kpi purple">
        <div class="value">{{currentMonth.revenue}} F</div>
        <div class="label">CA total</div>
      </div>
      <div class="kpi">
        <div class="value">{{currentMonth.sales}}</div>
        <div class="label">Ventes</div>
      </div>
      <div class="kpi red">
        <div class="value">{{currentMonth.cogs}} F</div>
        <div class="label">Cout marchand.</div>
      </div>
      <div class="kpi green">
        <div class="value">{{currentMonth.grossMargin}} F</div>
        <div class="label">Marge brute {{currentMonth.grossMarginPct}}%</div>
      </div>
    </div>

    <div class="margin-box">
      <div class="title">Decomposition financiere du mois</div>
      <div class="margin-row">
        <span class="lbl">Chiffre d'affaires</span>
        <span class="val">{{currentMonth.revenue}} FCFA</span>
      </div>
      <div class="margin-row">
        <span class="lbl">- Cout des marchandises</span>
        <span class="val">{{currentMonth.cogs}} FCFA</span>
      </div>
      <div class="margin-row">
        <span class="lbl">= Marge brute <span class="pct">{{currentMonth.grossMarginPct}}%</span></span>
        <span class="val">{{currentMonth.grossMargin}} FCFA</span>
      </div>
      <div class="margin-row">
        <span class="lbl">- Depenses operationnelles</span>
        <span class="val">{{currentMonth.expenses}} FCFA</span>
      </div>
      <div class="margin-row total">
        <span class="lbl">= Benefice net</span>
        <span class="val">{{currentMonth.netRevenue}} FCFA</span>
      </div>
    </div>

    <div class="compare-grid">
      <div class="compare-card current">
        <h4>{{monthLabel}}</h4>
        <div class="val">{{currentMonth.revenue}} FCFA</div>
        <div class="sub">
          Marge: {{currentMonth.grossMargin}} FCFA<br/>
          Depenses: {{currentMonth.expenses}} FCFA<br/>
          <strong>Benefice: {{currentMonth.netRevenue}} FCFA</strong>
        </div>
      </div>
      <div class="compare-card previous">
        <h4>Mois precedent</h4>
        <div class="val">{{previousMonth.revenue}} FCFA</div>
        <div class="sub">
          Marge: {{previousMonth.grossMargin}} FCFA<br/>
          Depenses: {{previousMonth.expenses}} FCFA<br/>
          <strong>Benefice: {{previousMonth.netRevenue}} FCFA</strong>
        </div>
      </div>
    </div>

    <h3>Evolution par semaine</h3>
    <table>
      <thead><tr><th>Semaine</th><th>Ventes</th><th>CA (F)</th><th>Marge (F)</th></tr></thead>
      <tbody>
        {{#each weeklyBreakdown}}
        <tr>
          <td>{{this.week}}</td>
          <td>{{this.sales}}</td>
          <td>{{this.revenue}}</td>
          <td><strong>{{this.margin}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    {{#if topProducts.length}}
    <h3>Top 5 Produits</h3>
    <table>
      <thead><tr><th>Produit</th><th>Qte</th><th>CA (F)</th><th>Marge (F)</th></tr></thead>
      <tbody>
        {{#each topProducts}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.qty}}</td>
          <td>{{this.revenue}}</td>
          <td><strong>{{this.margin}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if topCategories.length}}
    <h3>Top Categories</h3>
    <table>
      <thead><tr><th>Categorie</th><th>CA (F)</th><th>Marge (F)</th></tr></thead>
      <tbody>
        {{#each topCategories}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.revenue}}</td>
          <td><strong>{{this.margin}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if lowStockProducts.length}}
    <h3>Produits en stock bas</h3>
    <table>
      <thead><tr><th>Produit</th><th>Stock</th><th>Unite</th></tr></thead>
      <tbody>
        {{#each lowStockProducts}}
        <tr>
          <td>{{this.name}}</td>
          <td><span class="badge-warn">{{this.stock}}</span></td>
          <td>{{this.unit}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

  </div>
  <div class="footer">&copy; {{year}} SP Service - Rapport genere automatiquement</div>
</div>
</body>
</html>
